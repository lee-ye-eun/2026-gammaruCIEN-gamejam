  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7eb96907bf83049758c1bfc8dd7f8792, type: 3}
  m_Name: TutorialData
  m_EditorClassIdentifier: Assembly-CSharp::TutorialData
  steps:
  - state: 0
    text: "\uC190\uB2D8\uC758 \uACE0\uBBFC\uC744 \uB4E3\uACE0, \uACE0\uBBFC\uC758
      \uD574\uB2F5\uC744 \uCD94\uCE21\uD558\uC138\uC694."
    highlightPosition: {x: 0, y: -270}
    highlightSize: {x: 1920, y: 540}
  - state: 1
    text: "\uC190\uB2D8 \uC8FC\uBCC0\uC5D0 \uC758\uC2EC\uAC00\uB294 \uC601\uC5ED\uC744
      \uD130\uCE58\uD558\uC5EC \uB2E8\uC11C\uB97C \uC218\uC9D1\uD558\uC138\uC694."
    highlightPosition: {x: -300, y: 100}
    highlightSize: {x: 600, y: 800}
  - state: 2
    text: "\uD0C0\uB85C \uACB0\uACFC\uB97C \uB0B4\uAE30 \uC804, \uC9C8\uBB38\uC744
      \uD1B5\uD574 \uB2E8\uC11C\uB97C \uD655\uBCF4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightPosition: {x: 600, y: 300}
    highlightSize: {x: 700, y: 600}
  - state: 2
    text: "\uD22C\uC2DC\uACBD\uC744 On\uD558\uC5EC \uB4A4\uC9D1\uD78C \uD0C0\uB85C
      \uCE74\uB4DC\uC758 \uC885\uB958\uAC00 \uBB34\uC5C7\uC778\uC9C0 \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD22C\uC2DC\uACBD\uC740 \uC548\uACBD\uC758
      \uC0C9\uC774 \uBC14\uB00C\uAE30 \uB54C\uBB38\uC5D0, \uC624\uB798 \uCF1C\uB450\uBA74
      \uC758\uC2EC\uC744 \uC0B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightPosition: {x: 800, y: -500}
    highlightSize: {x: 550, y: 350}
  - state: 2
    text: "\uC88C\uCE21 \uC0C1\uB2E8\uC5D0\uB294 \uC758\uC2EC\uB3C4 \uAC8C\uC774\uC9C0\uAC00
      \uB098\uD0C0\uB0A9\uB2C8\uB2E4.\n\uC758\uC2EC\uB3C4 \uAC8C\uC774\uC9C0\uB294
      \uC9C8\uBB38\uC744 2\uD68C \uC774\uC0C1 \uD558\uAC70\uB098, \uD22C\uC2DC\uACBD\uC744
      \uC624\uB798 \uC4F8 \uC2DC \uB298\uC5B4\uB0A9\uB2C8\uB2E4.\n\uC758\uC2EC\uB3C4\uAC00
      100\uC774 \uB418\uBA74 \uC989\uC2DC \uAC8C\uC784 \uC624\uBC84 \uB429\uB2C8\uB2E4."
    highlightPosition: {x: -800, y: 600}
    highlightSize: {x: 750, y: 300}
  - state: 2
    text: "\uC88C\uCE21 \uD558\uB2E8\uC758 \uC885\uC774\uB97C \uD1B5\uD574 \uC9C0\uAE08\uAE4C\uC9C0
      \uD655\uBCF4\uD55C \uB2E8\uC11C\uC640,\n\uD0C0\uB85C\uCE74\uB4DC\uC758 \uD574\uC11D\uD45C\uB97C
      \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    highlightPosition: {x: -800, y: -500}
    highlightSize: {x: 400, y: 400}
  - state: 2
    text: "\uC774\uC81C \uCD94\uCE21\uD55C \uB2E8\uC11C\uB97C \uD1B5\uD574\n\"\uC6D0\uC778\",
      \"\uD604\uC7AC\", \"\uC870\uC5B8\"\uC5D0 \uC801\uC808\uD55C \uD0C0\uB85C \uCE74\uB4DC\uB97C
      \uB123\uC73C\uC138\uC694."
    highlightPosition: {x: 0, y: 0}
    highlightSize: {x: 1920, y: 1080}
